<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>

    <!-- BO build script properties -->
    <ModFolder>BOSpecialFools</ModFolder>
    <ModInfoFolder>ModInfo</ModInfoFolder>
    <ModDLLFolder>plugins</ModDLLFolder>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="AssetBundle\**" />
    <Compile Remove="ModInfo\**" />
    <EmbeddedResource Remove="AssetBundle\**" />
    <EmbeddedResource Remove="ModInfo\**" />
    <None Remove="AssetBundle\**" />
    <None Remove="ModInfo\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\Items\Item19.png" />
    <None Remove="Resources\Items\OldBleach.png" />
    <None Remove="Resources\Items\TrueZeal.png" />
    <None Remove="Resources\WreathBack.png" />
    <None Remove="Resources\WreathFront.png" />
    <None Remove="Resources\WreathLocked.png" />
    <None Remove="Resources\WreathOW.png" />
    <None Remove="Resources\WreathUnlocked.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Characters\Wreath\WreathBack.png" />
    <EmbeddedResource Include="Resources\Characters\Wreath\WreathFront.png" />
    <EmbeddedResource Include="Resources\Characters\Wreath\WreathLocked.png" />
    <EmbeddedResource Include="Resources\Characters\Wreath\WreathOW.png" />
    <EmbeddedResource Include="Resources\Characters\Wreath\WreathUnlocked.png" />
    <EmbeddedResource Include="Resources\Items\Item19.png" />
    <EmbeddedResource Include="Resources\Items\OldBleach.png" />
    <EmbeddedResource Include="Resources\Items\TrueZeal.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="UnityEngine.Modules" Version="2020.3.49">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>compile</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\References\BrutalOrchestra\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="BrutalAPI">
      <HintPath>..\Pentacle\bin\Release\netstandard2.0\BrutalAPI.dll</HintPath>
    </Reference>
    <Reference Include="Grimoire">
      <HintPath>..\Grimoire\bin\Debug\netstandard2.0\Grimoire.dll</HintPath>
    </Reference>
    <Reference Include="Pentacle">
      <HintPath>..\Pentacle\bin\Debug\netstandard2.0\Pentacle.dll</HintPath>
    </Reference>
    <Reference Include="YarnSpinner">
      <HintPath>..\References\Unity\YarnSpinner.dll</HintPath>
    </Reference>
    <Reference Include="YarnSpinner.Compiler">
      <HintPath>..\References\Unity\YarnSpinner.Compiler.dll</HintPath>
    </Reference>
    <Reference Include="YarnSpinner.Unity">
      <HintPath>..\References\Unity\YarnSpinner.Unity.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="AssetBundle\AssetBundles\157fools" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="set &quot;outdir=$(OutDir)&quot;&#xD;&#xA;set &quot;assemblyname=$(AssemblyName)&quot;&#xD;&#xA;set &quot;modfolder=$(ModFolder)&quot;&#xD;&#xA;set &quot;modinfofolder=$(ModInfoFolder)&quot;&#xD;&#xA;set &quot;dllfolder=$(ModDLLFolder)&quot;&#xD;&#xA;call bobuild_win.bat" Condition="$([MSBuild]::IsOSPlatform('Windows'))"/>
    <Exec Command="export OUTDIR=&quot;$(OutDir)&quot;&#xD;&#xA;export ASSEMBLYNAME=&quot;$(AssemblyName)&quot;&#xD;&#xA;export MODFOLDER=&quot;$(ModFolder)&quot;&#xD;&#xA;export MODINFOFOLDER=&quot;$(ModInfoFolder)&quot;&#xD;&#xA;export DLLFOLDER=&quot;$(ModDLLFolder)&quot;&#xD;&#xA;./bobuild_lin.sh" Condition="$([MSBuild]::IsOSPlatform('Linux'))"/>
  </Target>

</Project>
